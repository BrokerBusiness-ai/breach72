# Copy to .env and fill in. Never commit .env.
# With SAMPLE_MODE=true and every other value empty, Breach72 replays recorded Zetaris responses.
SAMPLE_MODE=true

# Zetaris (local platform per Participant Setup Guide)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=your-org-id
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_QUERY_PATH=/query
SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# NVIDIA hosted API (build.nvidia.com)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_LARGE=nvidia/llama-3.3-nemotron-super-49b-v1.5
MODEL_SMALL=nvidia/nvidia-nemotron-nano-9b-v2
